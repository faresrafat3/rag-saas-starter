# =============================================================================
# rag-saas-starter — Environment Variables Template
# =============================================================================
# Copy this file to `.env.local` and fill in your actual values.
# NEVER commit `.env.local` — it is in .gitignore.

# -----------------------------------------------------------------------------
# AI Provider Configuration
# -----------------------------------------------------------------------------
# This starter uses the Vercel AI SDK pattern, which is provider-agnostic.
# For the demo, you can use any of the following providers:

# Option 1: OpenAI (most common)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option 2: Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option 3: Custom provider base URL (e.g., self-hosted, Azure, etc.)
# CUSTOM_AI_BASE_URL=https://your-provider.com/v1
# CUSTOM_AI_API_KEY=your_key_here

# The active provider is selected in `lib/ai-provider.ts`
# Default: OpenAI (if OPENAI_API_KEY is set)
AI_PROVIDER=openai  # openai | anthropic | custom

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------
AI_MODEL=gpt-4o-mini  # or: gpt-4o, claude-3-5-sonnet, etc.
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# -----------------------------------------------------------------------------
# Vector Store / Database (for RAG — coming in session 5)
# -----------------------------------------------------------------------------
# Option A: Local SQLite (default for development)
DATABASE_URL=file:./dev.db

# Option B: Supabase (for production)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="RAG SaaS Starter"
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_DEFAULT_THEME=system  # system | light | dark

# -----------------------------------------------------------------------------
# (Session 6 will add: deployment URLs, analytics, etc.)
# -----------------------------------------------------------------------------
